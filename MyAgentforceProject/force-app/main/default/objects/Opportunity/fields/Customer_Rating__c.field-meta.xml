<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Customer_Rating__c</fullName>
    <label>Customer Rating</label>
    <description>Classifies the strategic tier of the customer for this opportunity, used to select the appropriate business process configuration.</description>
    <inlineHelpText>Select the customer relationship tier: Standard for transactional accounts, Preferred for key accounts, Strategic for enterprise or named accounts requiring elevated process steps.</inlineHelpText>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Standard</fullName>
                <default>false</default>
                <label>Standard</label>
            </value>
            <value>
                <fullName>Preferred</fullName>
                <default>false</default>
                <label>Preferred</label>
            </value>
            <value>
                <fullName>Strategic</fullName>
                <default>false</default>
                <label>Strategic</label>
            </value>
        </valueSetDefinition>
    </valueSet>
    <trackHistory>false</trackHistory>
    <trackFeedHistory>false</trackFeedHistory>
</CustomField>
